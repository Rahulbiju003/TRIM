{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/check-file-size.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/check-bash-read.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
