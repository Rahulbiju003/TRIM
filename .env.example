# ── Provider API keys ─────────────────────────────────────────────────────────
# Only set the key for the provider you're using.
# openrouter.ai (free tier available)
OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...

# ── Model selection ───────────────────────────────────────────────────────────
# Any LiteLLM model string. Change provider by changing this one value.
WORKER_MODEL=openrouter/nex-agi/nex-n2.5-mini:free

# Free tier alternatives (verify current availability at openrouter.ai/models):
# WORKER_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free
# WORKER_MODEL=openrouter/nex-agi/nex-n2.5-pro:free

# Paid models (better quality, requires credits):
# WORKER_MODEL=openrouter/google/gemini-2.5-flash
# WORKER_MODEL=openrouter/deepseek/deepseek-chat-v3-0324

# Other providers (set the matching API key above):
# WORKER_MODEL=gemini/gemini-2.5-flash
# WORKER_MODEL=claude-haiku-4-5-20251001
# WORKER_MODEL=ollama/qwen2.5-coder:7b

# ── Routing thresholds ────────────────────────────────────────────────────────
# Files above SHUNT_MIN_LINES are delegated to the worker LLM.
SHUNT_MIN_LINES=350
# Worker timeout in seconds — hook fails-open if exceeded.
SHUNT_TIMEOUT_SECONDS=45
# Max payload bytes. Use 400000 on macOS, 120000 on Linux (pipe buffer limit).
SHUNT_MAX_BYTES=400000

# ── Deployment mode ───────────────────────────────────────────────────────────
# Leave unset (commented out) for subprocess mode — zero infrastructure needed.
# Set to the base URL of your running worker container or remote server.
# WORKER_URL=http://localhost:8080

# ── Rate limiting (HTTP mode only) ───────────────────────────────────────────
# Requests per minute cap for /bulk-read, across the whole server (not per-IP).
# 0 = disabled (default). The hook fails-open on 429 — Claude reads the file
# normally if the limit is hit, so legitimate work is never blocked.
# For a team of 10 devs, 600 (10/s average) is generous.
# SHUNT_RATE_LIMIT_RPM=0

# ── Auth (HTTP mode only) ─────────────────────────────────────────────────────
# Optional. Set on the server to require callers to send X-TRIM-Key header.
# Leave unset for local/trusted use (no auth check).
# TRIM_API_KEY=change-me-to-a-strong-random-secret

# ── Metrics ───────────────────────────────────────────────────────────────────
SHUNT_METRICS_FILE=/tmp/trim-metrics.jsonl

# ── Server (HTTP mode only) ───────────────────────────────────────────────────
WORKER_PORT=8080
WORKER_TEMPERATURE=0.2
