# ── Provider API keys ─────────────────────────────────────────────────────────
# Only set the key for the provider you're using.
OPENROUTER_API_KEY=sk-or-...          # openrouter.ai (free tier available)
# ANTHROPIC_API_KEY=sk-ant-...        # Claude Haiku direct
# GEMINI_API_KEY=...                  # Gemini direct
# OPENAI_API_KEY=sk-...               # OpenAI direct

# ── Model selection ───────────────────────────────────────────────────────────
# Any LiteLLM model string. Change provider by changing this one value.
WORKER_MODEL=openrouter/google/gemma-3n-e4b-it:free

# Examples:
# WORKER_MODEL=openrouter/google/gemini-2.5-flash          # best quality via OpenRouter
# WORKER_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct:free
# WORKER_MODEL=openrouter/deepseek/deepseek-chat-v3-0324:free
# WORKER_MODEL=gemini/gemini-2.5-flash                     # direct Google API
# WORKER_MODEL=claude-haiku-4-5-20251001                   # direct Anthropic
# WORKER_MODEL=ollama/qwen2.5-coder:7b                     # local Ollama

# ── Routing thresholds ────────────────────────────────────────────────────────
SHUNT_MIN_LINES=350          # files above this line count are delegated
SHUNT_TIMEOUT_SECONDS=45     # worker timeout (fail-open if exceeded)
SHUNT_MAX_BYTES=400000       # max payload bytes (macOS: 400000, Linux: 120000)

# ── Deployment mode ───────────────────────────────────────────────────────────
# Leave unset for subprocess mode (zero infra, default).
# Set to run against a local container or remote server.
# WORKER_URL=http://localhost:8080

# ── Auth (HTTP mode only) ─────────────────────────────────────────────────────
# Optional. Set on the server to require callers to send X-TRIM-Key header.
# Leave unset for local/trusted use (no auth check).
# TRIM_API_KEY=change-me-to-a-strong-random-secret

# ── Metrics ───────────────────────────────────────────────────────────────────
SHUNT_METRICS_FILE=/tmp/trim-metrics.jsonl

# ── Server (HTTP mode only) ───────────────────────────────────────────────────
WORKER_PORT=8080
WORKER_TEMPERATURE=0.2
